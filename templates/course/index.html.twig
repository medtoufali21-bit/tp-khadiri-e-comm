{% extends 'layout.html.twig' %}

{% block title %}Deposer un support{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h1 class="h3 mb-4">Deposer un support pedagogique</h1>
                    {{ form_start(form) }}
                    {{ form_row(form.title, {label: 'Titre'}) }}
                    {{ form_row(form.summary, {label: 'Resume'}) }}
                    {{ form_row(form.file, {label: 'Support du cours'}) }}
                    <button class="btn btn-primary" type="submit">Publier le support</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
